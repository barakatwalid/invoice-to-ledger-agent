# Copy to .env locally. Do not paste credentials into any chat or commit them.
# The starter's optional read-only probe uses only these first two variables.
TELNYX_API_KEY=
TELNYX_INBOX_ID=
# Required by the one-shot live slice. The local agent falls back to the reviewed public
# selector in config/local-agent-provider.json. Any configured model is verified against
# GET /v2/ai/openai/models before extraction.
EXTRACTION_MODEL_ID=
# Optional trusted inference setting. The verified live GLM path used `high`.
EXTRACTION_REASONING_EFFORT=
# Exact subject of the single authorized synthetic test message.
TELNYX_TARGET_SUBJECT=Synthetic bookkeeping invoice BK-2026-001
# Optional if the subject is unique; set this to disambiguate repeated test sends.
TELNYX_TARGET_MESSAGE_ID=
# Comma-separated exact HTTPS hostnames returned by `npm run discover:attachment-host`.
# The local agent falls back to the reviewed exact host in config/local-agent-provider.json.
# Verify the reported hostname before trusting it; discovery performs no download.
# No bearer token is ever sent to these hosts. Wildcards and IP literals are rejected.
TELNYX_ATTACHMENT_HOSTS=
# Optional local-agent controls. Leave LOCAL_AGENT_SUBJECT_FILTER empty to accept any
# received message containing exactly one attached PDF, JPEG, or PNG in this dedicated test inbox.
LOCAL_AGENT_SUBJECT_FILTER=
LOCAL_AGENT_POLL_INTERVAL_SECONDS=60
LOCAL_AGENT_HOST=127.0.0.1
PORT=3000
# Optional. When omitted locally, a mode-0600 token is generated under .private/.
# For hosted deployment, configure this as an encrypted secret with at least 32 characters.
BOOKKEEPING_CONTROL_TOKEN=
BOOKKEEPING_DATA_DIR=.private
# Used only if a signed webhook intake is implemented later.
TELNYX_WEBHOOK_PUBLIC_KEY=
# App environment loading is separate from telnyx-edge CLI authentication.
# Deployed Agent SDK values use the five named [[secrets]] entries in telnyx.toml. Configure
# them through an approved `telnyx-edge secrets add` session; do not put the control token here.
# Public invoke base URL returned only after a successful Edge deployment.
EDGE_INVOKE_URL=
